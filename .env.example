# MySQL/MariaDB (hPanel: Bases de Dados). No alojamento usa 127.0.0.1.
DATABASE_URL="mysql://utilizador:password@127.0.0.1:3306/inread"

# Segredo partilhado com o router de email (Cloudflare Worker envia no header x-inread-secret)
INBOUND_WEBHOOK_SECRET="muda-isto-para-um-segredo-longo"

# Limite do plano Free (rotação FIFO)
FREE_NEWSLETTER_LIMIT="50"
