datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(uuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  inboxHash     String?      @unique // ex: "jorge_x9" -> jorge_x9@inread.app (gerado no 1.º login)
  plan          String       @default("free") // "free" | "pro"
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt     DateTime     @default(now())
  newsletters   Newsletter[]
  accounts      Account[]
  sessions      Session[]
  podcastsFavoritos  PodcastFavorito[]
  episodiosGuardados EpisodioGuardado[]
  pushSubs      PushSub[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Newsletter {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  senderName  String?
  senderEmail String
  subject     String
  contentHtml String   @db.LongText
  contentText String?  @db.LongText
  format      String   @default("newsletter") // "newsletter" | "video" | "thread" | "artigo" (etiqueta automática de formato)
  contextTag  String? // etiqueta automática de contexto: "Trabalho" | "Finanças" | "Tecnologia" | "Notícias" | "Lazer"
  listUnsubscribe String? @db.Text // header List-Unsubscribe (cancelar subscrição num clique)
  readingTime Int? // em minutos

  isRead      Boolean  @default(false)
  isStarred   Boolean  @default(false)
  createdAt   DateTime @default(now())

  highlights  Highlight[]
  tags        Tag[]

  @@index([userId, createdAt])
  @@map("newsletters")
}

model Highlight {
  id           String     @id @default(uuid())
  newsletterId String
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  text         String     @db.Text
  note         String?    @db.Text
  createdAt    DateTime   @default(now())

  @@map("highlights")
}

model Tag {
  id          String       @id @default(uuid())
  name        String
  kind        String       @default("context") // "context" (do utilizador) | "format" (automática)
  newsletters Newsletter[]

  @@map("tags")
}

model PodcastFavorito {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedUrl         String    @db.Text
  nome            String
  autor           String?
  imagem          String?   @db.Text
  ultimaDataVista String? // pubDate (texto RSS) do episódio mais recente já visto — para o aviso de "novo"
  createdAt       DateTime  @default(now())

  @@unique([userId, feedUrl(length: 255)])
  @@index([userId])
  @@map("podcast_favoritos")
}

model EpisodioGuardado {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedUrl        String   @db.Text
  podcastNome    String
  podcastImagem  String?  @db.Text
  titulo         String
  audioUrl       String   @db.Text
  duracao        String?
  dataPublicacao String?
  createdAt      DateTime @default(now())

  @@unique([userId, audioUrl(length: 255)])
  @@index([userId])
  @@map("episodios_guardados")
}

model EmailChange {
  id        String   @id @default(uuid())
  userId    String
  novoEmail String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_changes")
}

/// Subscrição de notificações push (um registo por dispositivo/browser).
model PushSub {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(700)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(100)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subs")
}

/// Chaves VAPID (geradas uma vez, no primeiro uso) — evita configurar variáveis de ambiente.
model PushConfig {
  id         String @id
  publicKey  String @db.VarChar(255)
  privateKey String @db.VarChar(255)

  @@map("push_config")
}
