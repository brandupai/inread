datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(uuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  inboxHash     String?      @unique // ex: "jorge_x9" -> jorge_x9@inread.app (gerado no 1.º login)
  plan          String       @default("free") // "free" | "pro"
  createdAt     DateTime     @default(now())
  newsletters   Newsletter[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Newsletter {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  senderName  String?
  senderEmail String
  subject     String
  contentHtml String   @db.LongText
  contentText String?  @db.LongText
  format      String   @default("newsletter") // "newsletter" | "video" | "thread" | "artigo" (etiqueta automática de formato)
  contextTag  String? // etiqueta automática de contexto: "Trabalho" | "Finanças" | "Tecnologia" | "Notícias" | "Lazer"
  listUnsubscribe String? @db.Text // header List-Unsubscribe (cancelar subscrição num clique)
  readingTime Int? // em minutos

  isRead      Boolean  @default(false)
  isStarred   Boolean  @default(false)
  createdAt   DateTime @default(now())

  highlights  Highlight[]
  tags        Tag[]

  @@index([userId, createdAt])
  @@map("newsletters")
}

model Highlight {
  id           String     @id @default(uuid())
  newsletterId String
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  text         String     @db.Text
  note         String?    @db.Text
  createdAt    DateTime   @default(now())

  @@map("highlights")
}

model Tag {
  id          String       @id @default(uuid())
  name        String
  kind        String       @default("context") // "context" (do utilizador) | "format" (automática)
  newsletters Newsletter[]

  @@map("tags")
}
